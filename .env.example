# Environment Configuration for Tanzania Transparent Platform

# Hedera Hashgraph Configuration
HEDERA_ACCOUNT_ID=0.0.123456
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_NETWORK=testnet
HEDERA_CONSENSUS_TOPIC_ID=0.0.789012

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tanzania_platform
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_ENABLED=true

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_KEY=your-256-bit-encryption-key-here
SIGNAL_PROTOCOL_STORE_PATH=./signal_store

# Server Configuration
NODE_ENV=production
PORT=3000
CLUSTER_INSTANCES=8
MAX_CONCURRENT_CONNECTIONS=10000

# Regional Node Configuration
REGION=DAR_ES_SALAAM
NODE_ID=tanzania-node-01
BACKUP_NODES=tanzania-node-02,tanzania-node-03

# Anti-Censorship Configuration
MESH_NETWORK_ENABLED=true
DOMAIN_FRONTING_ENABLED=true
STEGANOGRAPHY_ENABLED=true
SATELLITE_FALLBACK_ENABLED=true

# Communication Channels
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+255700000000
SMS_FALLBACK_ENABLED=true
EMAIL_SERVICE=gmail
EMAIL_USER=tanzania.platform@gmail.com
EMAIL_PASS=your-email-password

# AI Moderation Configuration
AI_MODERATION_ENABLED=true
MODERATION_THRESHOLD=0.8
PROFANITY_FILTER_ENABLED=true
PROPAGANDA_DETECTION_ENABLED=true
NEUTRALITY_ENFORCEMENT=true
MODERATION_TRANSPARENCY_REPORTS=true

# Performance Configuration
CACHE_TTL=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
AI_MODERATION_TIMEOUT_MS=500
VOTE_PROCESSING_TIMEOUT_MS=1000

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=30000
DDOS_PROTECTION_ENABLED=true
AUTOMATED_FAILOVER_ENABLED=true
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Blockchain DNS Configuration
BLOCKCHAIN_DNS_ENABLED=true
DNS_SEEDS=dns1.tanzania-democracy.platform,dns2.tanzania-democracy.platform
DNS_RESOLVER_TIMEOUT_MS=5000

# Mobile App Configuration
MOBILE_APP_VERSION=1.0.0
MINIMUM_APP_VERSION=1.0.0
APP_DOWNLOAD_URL=https://tanzania-democracy.platform/download
OFFLINE_MODE_ENABLED=true
MAX_APP_SIZE_MB=10

# Voting System Configuration
VOTING_ENABLED=true
VOTE_ANONYMITY_LEVEL=maximum
VOTE_VERIFICATION_ENABLED=true
REAL_TIME_RESULTS=true
CRYPTOGRAPHIC_RECEIPTS=true
AUDIT_TRAIL_ENABLED=true

# Load Balancing Configuration
LOAD_BALANCER_ALGORITHM=round-robin
HEALTH_CHECK_PATH=/health
FAILOVER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_ENABLED=true

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.tanzania-democracy.platform
STATIC_ASSET_CACHE_TTL=86400
DYNAMIC_CONTENT_CACHE_TTL=300

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_STORAGE_PROVIDER=s3

# Legal Compliance
DATA_RETENTION_DAYS=90
PRIVACY_POLICY_URL=https://tanzania-democracy.platform/privacy
TERMS_OF_SERVICE_URL=https://tanzania-democracy.platform/terms
GDPR_COMPLIANCE_ENABLED=true
DATA_LOCALIZATION_ENABLED=true